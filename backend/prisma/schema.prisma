// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  fullName  String
  phone     String?
  avt_img   String?  // Avatar image URL
  gender    String?  // Giới tính: Nam, Nữ, Khác
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Address fields
  province     String?  
  provinceName String?  
  district     String?   
  ward         String?  
  wardName     String?  
  street       String? 
  fullAddress  String?  

  // Relations
  orders    Order[]
  tickets   Ticket[]
  reviews   Review[]
  auditLogs AuditLog[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products    Product[]
  // Self relation for nested categories
  parentId    String?
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToCategory")

  // Unique constraint: same name cannot exist under same parent
  @@unique([name, parentId], name: "unique_name_per_parent")
  @@map("categories")
}

model Product {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?
  price       Int             @default(0)
  stock       Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  orderItems  OrderItem[]
  reviews     Review[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  order     Int      @default(0)

  productId String
  product   Product  @relation(fields: [productId], references: [id])

  @@map("product_images")
}

model Order {
  id          String       @id @default(cuid())
  code        String       @unique
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  status      OrderStatus  @default(PENDING)
  totalAmount Int          @default(0)
  paidAmount  Int          @default(0)
  isPaid      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  items       OrderItem[]
  payments    Payment[]
  returns     ReturnRequest[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int     @default(1)
  price     Int     @default(0)

  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  amount    Int           @default(0)
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())

  order     Order         @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model ReturnRequest {
  id           String            @id @default(cuid())
  orderId      String
  reason       String
  status       ReturnStatus      @default(PENDING)
  refundAmount Int               @default(0)
  createdAt    DateTime          @default(now())

  order        Order             @relation(fields: [orderId], references: [id])

  @@map("return_requests")
}

model Ticket {
  id        String      @id @default(cuid())
  userId    String
  subject   String
  content   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())

  user      User        @relation(fields: [userId], references: [id])

  @@map("tickets")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int      @default(5)
  content   String
  status    ReviewStatus @default(PUBLISHED)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@map("reviews")
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  resource   String   // USER, PRODUCT, ORDER, etc.
  resourceId String?  // ID of the affected resource
  details    Json?    // Additional details about the action
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}